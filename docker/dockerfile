# Use this to build and run the Micro-ROS agent.

FROM ros:kilted-perception-noble

ENV DEBIAN_FRONTEND=noninteractive

# Install basic tools.
RUN apt update \
    && apt install -y --no-install-recommends \
        sudo \
        vim \
        nano \
        wget \
        apt-utils \
        gdb \
        less \
    && rm -rf /var/lib/apt/lists/*

# Install ROS2 desktop packages.
RUN apt update \
    && apt install -y --no-install-recommends \
        ros-kilted-desktop \
        python3-vcstool \
    && rm -rf /var/lib/apt/lists/*

# User ubuntu is created in the base image.
# Add user ubuntu to sudoers list.
RUN mkdir -p /etc/sudoers.d/ && \
    echo "ubuntu ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/ubuntu && \
    chmod 0440 /etc/sudoers.d/ubuntu

# Source ROS2 setup script for each shell and vcstool auto complete.
RUN echo ". /opt/ros/kilted/setup.bash" > /home/ubuntu/.bash_aliases && \
    echo ". /usr/share/vcstool-completion/vcs.bash" >> /home/ubuntu/.bash_aliases

# Use display
ENV DISPLAY=:1.0

# Change to user ubuntu.
ENV HOME=/home/ubuntu
USER ubuntu
WORKDIR /home/ubuntu/ws
