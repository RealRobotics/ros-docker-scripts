#

FROM ros:kilted-perception-noble

ENV DEBIAN_FRONTEND noninteractive

# Install basic tools.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        sudo \
        vim \
        nano \
        wget \
        apt-utils \
        gdb \
        less \
    && rm -rf /var/lib/apt/lists/*

# Install ROS2 desktop packages.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ros-kilted-desktop=0.9.2-1* \
        python3-vcstool \
    && rm -rf /var/lib/apt/lists/*

# Install Gazebo packages.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ros-${ROS_DISTRO}-ros-gz \
    && rm -rf /var/lib/apt/lists/*

# nvidia-container-runtime
ENV NVIDIA_VISIBLE_DEVICES \
    ${NVIDIA_VISIBLE_DEVICES:-all}
ENV NVIDIA_DRIVER_CAPABILITIES \
    ${NVIDIA_DRIVER_CAPABILITIES:+$NVIDIA_DRIVER_CAPABILITIES,}graphics

# Create user with UID and GID matching those on my PC.
# This allows the user to delete build products created in the source tree.
# Also add user build to sudoers list.
RUN groupadd -g 1000 build && \
    useradd -u 1000 -g 1000 -m -s /bin/bash build && \
    mkdir -p /etc/sudoers.d/ && \
    echo "build ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/build && \
    chmod 0440 /etc/sudoers.d/build
ENV HOME /home/build

# Source ROS2 setup script for each shell and vcstool auto complete.
RUN echo ". /opt/ros/kilted/setup.bash" > /home/build/.bash_aliases && \
    echo ". /usr/share/vcstool-completion/vcs.bash" >> /home/build/.bash_aliases

# Change ownership of build directory to build:build.
RUN chown -R build:build /home/build/

# Change to user build.
USER build
